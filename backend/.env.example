# Backend Environment Configuration for Production (Render)

PORT=5000
NODE_ENV=production

# Frontend Client URL on Vercel (comma-separated if multiple domains or preview URLs)
CLIENT_URL=https://your-vercel-frontend-url.vercel.app,http://localhost:5173

# PostgreSQL Database URL (Render Managed PostgreSQL or Supabase / Neon connection string)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Authentication
JWT_SECRET=super_secret_jwt_key_resqnet_2026_emergency
JWT_EXPIRES_IN=7d

# File Storage (local or S3)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
